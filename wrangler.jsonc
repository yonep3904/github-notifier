{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-notifier",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-26",
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATION_QUEUE",
        "queue": "notification-queue"
      }
    ],
    "consumers": [
      {
        "queue": "notification-queue",
        "max_retries": 5
      }
    ]
  },
  "assets": {
    "directory": "./dist"
  }
}
