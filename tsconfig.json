{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",

    // Path aliases
    "paths": {
      "@/*": ["./src/*"],
      "test/*": ["./test/*"]
    },

    // Vitest globals
    "types": ["vitest/globals", "vite/client"]
  }
}
